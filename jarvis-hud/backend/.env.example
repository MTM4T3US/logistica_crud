# JARVIS Core — configuração local. Copie para ".env" (que fica FORA do Git) e preencha.
# A chave só existe aqui no backend; o HUD (React/Vite) nunca a recebe.

# ---------------- IA: Google Gemini (desativada enquanto a chave estiver vazia) ----------------
# Crie a chave em https://aistudio.google.com/apikey — não é preciso habilitar faturamento.
GEMINI_API_KEY=
# Modelo de conversa. "auto" lista os modelos da SUA conta e escolhe o Flash estável mais novo.
# Para fixar um, use o nome exato mostrado em Configurações → IA (ex.: o que a lista indicar).
GEMINI_MODEL=auto
# Opcional: segundo modelo, usado se o principal falhar ou não existir.
GEMINI_FALLBACK_MODEL=
# Modelo de voz (TTS) e de transcrição. "auto"/vazio = escolhidos entre os que a conta lista.
GEMINI_TTS_MODEL=auto
GEMINI_STT_MODEL=
# true = ajusta automaticamente os modelos ao que a conta oferece; false = usa exatamente os nomes acima.
GEMINI_AUTO_MODEL=true
GEMINI_TIMEOUT_S=30
# Versão da API. A "v1" não aceita instrução de sistema nem lista os modelos de voz: use v1beta.
GEMINI_API_VERSION=v1beta
# Na inicialização, testa (um por vez, do mais novo ao mais antigo) qual modelo responde rápido
# e guarda a escolha por 12 h em backend/data/gemini_state.json, para poupar a cota.
GEMINI_PROBE_MODELS=true
# Tempo-alvo até o primeiro trecho da resposta ao escolher o modelo (segundos).
GEMINI_MAX_FIRST_TOKEN_S=1.5
# Pede o menor nível de raciocínio que o modelo aceitar (respostas faladas começam antes).
GEMINI_LOW_LATENCY=true
# Opcional: orçamento de "pensamento" (0 = respostas mais rápidas em modelos 2.5). Vazio = padrão do modelo.
GEMINI_THINKING_BUDGET=

# ---------------- Voz ----------------
# Síntese: auto (Gemini se houver chave, senão voz local) | gemini | local | off
JARVIS_TTS_ENGINE=auto
JARVIS_TTS_VOICE=Charon
# Interpretação: cinematografico | sobrio | caloroso | neutro
JARVIS_TTS_STYLE=cinematografico
# economico = no máximo 2 pedidos de voz por resposta (1ª frase + resto), por causa das cotas
# frase     = 1 pedido por frase, sintetizados em paralelo (voz mais fluida; gasta mais cota)
JARVIS_TTS_CHUNKING=economico
JARVIS_TTS_PARALLEL=3
# Transcrição: auto (Gemini se houver chave, senão Whisper local se instalado) | gemini | whisper | off
JARVIS_STT_ENGINE=auto
JARVIS_WHISPER_MODEL=small
JARVIS_WAKE_WORD=jarvis

# ---------------- Memória ----------------
# Memória de longo prazo (fatos que você pede para lembrar). O histórico da conversa é sempre local.
JARVIS_MEMORY_ENABLED=false
JARVIS_HISTORY_TURNS=16

# ---------------- Localização ----------------
JARVIS_CITY=Itumbiara
JARVIS_STATE=Goiás
JARVIS_STATE_CODE=GO
JARVIS_COUNTRY=Brasil
JARVIS_LATITUDE=-18.4192
JARVIS_LONGITUDE=-49.2153
JARVIS_TIMEZONE=America/Sao_Paulo
JARVIS_LANGUAGE=pt-BR

# ---------------- Serviços externos ----------------
# Clima: Open-Meteo (gratuito, sem chave). false desliga a consulta.
JARVIS_WEATHER_ENABLED=true
# Notícias: só com uma fonte verificável escolhida por você (URL de feed RSS/Atom). Vazio = sem notícias.
JARVIS_NEWS_RSS_URL=
# Simuladores dos dispositivos futuros (LEDs, persiana, fechadura, robô). Nenhum hardware é acionado.
JARVIS_DEVICE_SIMULATORS=true

# ---------------- Servidor local ----------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Opcional: token fixo do canal HUD⇄backend (por padrão é gerado a cada inicialização).
JARVIS_LOCAL_TOKEN=
