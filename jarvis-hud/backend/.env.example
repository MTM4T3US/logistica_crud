# JARVIS Core — configuração local. Copie para ".env" (que fica FORA do Git) e preencha.
# A chave só existe aqui no backend; o HUD (React/Vite) nunca a recebe.

# ---------------- IA: Google Gemini (desativada enquanto a chave estiver vazia) ----------------
# Crie a chave em https://aistudio.google.com/apikey — não é preciso habilitar faturamento.
GEMINI_API_KEY=
# Modelo de conversa. "auto" lista os modelos da SUA conta e escolhe o Flash estável mais novo.
# Para fixar um, use o nome exato mostrado em Configurações → IA (ex.: o que a lista indicar).
GEMINI_MODEL=auto
# Opcional: segundo modelo, usado se o principal falhar ou não existir.
GEMINI_FALLBACK_MODEL=
# Modelo de voz (TTS) e de transcrição. "auto"/vazio = escolhidos entre os que a conta lista.
GEMINI_TTS_MODEL=auto
GEMINI_STT_MODEL=
# true = ajusta automaticamente os modelos ao que a conta oferece; false = usa exatamente os nomes acima.
GEMINI_AUTO_MODEL=true
GEMINI_TIMEOUT_S=30
# Versão da API. A "v1" não aceita instrução de sistema nem lista os modelos de voz: use v1beta.
GEMINI_API_VERSION=v1beta
# false (padrão na 0.3): não gasta cota testando modelos ao iniciar; o núcleo aprende com o uso real
# (modelo que respondeu, cotas esgotadas, sobrecarga) e guarda em backend/data/gemini_state.json.
GEMINI_PROBE_MODELS=false
# Tempo-alvo até o primeiro trecho da resposta ao escolher o modelo (segundos).
GEMINI_MAX_FIRST_TOKEN_S=1.5
# Pede o menor nível de raciocínio que o modelo aceitar (respostas faladas começam antes).
GEMINI_LOW_LATENCY=true
# Opcional: orçamento de "pensamento" (0 = respostas mais rápidas em modelos 2.5). Vazio = padrão do modelo.
GEMINI_THINKING_BUDGET=

# ---------------- Voz ----------------
# Síntese: auto (Gemini → Piper local → voz do sistema) | gemini | piper | local | off
JARVIS_TTS_ENGINE=auto
JARVIS_TTS_VOICE=Charon
# Interpretação: cinematografico | sobrio | caloroso | neutro
JARVIS_TTS_STYLE=cinematografico
# economico = no máximo 2 pedidos de voz por resposta (1ª frase + resto), por causa das cotas
# frase     = 1 pedido por frase, sintetizados em paralelo (voz mais fluida; gasta mais cota)
JARVIS_TTS_CHUNKING=economico
JARVIS_TTS_PARALLEL=3
# Transcrição: auto (Whisper LOCAL se instalado, senão Gemini com sua autorização) | gemini | whisper | off
JARVIS_STT_ENGINE=auto
JARVIS_WHISPER_MODEL=small
JARVIS_WAKE_WORD=jarvis

# ---------------- Roteador ----------------
# local_first = comandos conhecidos (luzes, volume, música, janelas, programas, hora, clima) não gastam o Gemini
JARVIS_ROUTER=local_first

# ---------------- Escuta local ----------------
# Detector de "Jarvis" — SEMPRE no computador: auto | openwakeword | whisper | off
JARVIS_WAKE_ENGINE=auto
JARVIS_WAKE_THRESHOLD=0.5
# Opcional: modelo .onnx próprio da palavra "jarvis" (padrão: hey_jarvis do openWakeWord)
JARVIS_WAKE_MODEL=
# Depois de uma resposta, segue ouvindo sem exigir "Jarvis" por N segundos
JARVIS_CONVERSATION_WINDOW_S=8
# Transcrição local (faster-whisper): base | small | medium; dispositivo auto | cpu | cuda
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE=int8
# Voz Piper: caminho de um .onnx específico (padrão: backend/models/piper/*.onnx)
JARVIS_PIPER_MODEL=
JARVIS_MODELS_DIR=

# ---------------- LEDs (Bluetooth LE, chipset ELK-BLEDDM) ----------------
# simulador (padrão) | bluetooth (fita real) | off
JARVIS_LEDS=simulador
# Endereço da fita (vazio = procurar pelo nome). Veja com DIAGNOSTICO.bat --ble
# A fita testada com sucesso (ligar, desligar, azul) anunciava BE:27:53:00:BC:1B — confirme neste PC.
JARVIS_LED_ADDRESS=
JARVIS_LED_NAME_PREFIX=ELK-BLEDDM
# Brilho: cor (padrão — escurece a cor usando só o comando de cor, que foi validado na fita)
#         comando (usa o comando de brilho 7e 04 01 da referência pública; NÃO validado na fita)
JARVIS_LED_BRILHO=cor
# Efeitos na fita real: voz (o azul acompanha a fala do JARVIS), inicio (apresentação ao entrar com rosto/PIN —
# ou ao abrir o núcleo, se a entrada por rosto estiver desligada), off
JARVIS_LED_EFEITOS=voz,inicio

# ---------------- Memória ----------------
# Memória de longo prazo (fatos que você pede para lembrar). O histórico da conversa é sempre local.
JARVIS_MEMORY_ENABLED=false
JARVIS_HISTORY_TURNS=16

# ---------------- Localização ----------------
JARVIS_CITY=Itumbiara
JARVIS_STATE=Goiás
JARVIS_STATE_CODE=GO
JARVIS_COUNTRY=Brasil
JARVIS_LATITUDE=-18.4192
JARVIS_LONGITUDE=-49.2153
JARVIS_TIMEZONE=America/Sao_Paulo
JARVIS_LANGUAGE=pt-BR

# ---------------- Serviços externos ----------------
# Clima: Open-Meteo (gratuito, sem chave). false desliga a consulta.
JARVIS_WEATHER_ENABLED=true
# Notícias: só com uma fonte verificável escolhida por você (URL de feed RSS/Atom). Vazio = sem notícias.
# 0.4: por padrão, Google Notícias da cidade (7 dias) e do Brasil (1 dia) — os mesmos feeds do noticias_jarvis.py.
# JARVIS_NEWS_FEEDS=off desliga; ou "Rótulo|url;Rótulo|url" para escolher os seus.
JARVIS_NEWS_FEEDS=
# (compatibilidade com a 0.3: um único feed; se preenchido, substitui os de cima)
JARVIS_NEWS_RSS_URL=

# ---------------- Entrada por rosto (0.4) ----------------
# O cadastro é feito no HUD (Configurações → Entrada por rosto). Só números (descritores) ficam em data/rosto.json.
# Semelhança mínima para liberar (0..1). Mais alto = mais exigente (mais recusas do próprio dono).
JARVIS_FACE_THRESHOLD=0.62
# Piscar para entrar: desde a 0.6.1 é escolhido no HUD (Configurações → Entrada). Padrão: só o rosto.
# HUD fechado por mais que estes minutos → pede o rosto de novo ao abrir
JARVIS_FACE_RELOCK_MIN=2
# Nota anti-foto mínima (0 = só mostra a nota; calibre no seu PC antes de usar, ex.: 0.3)
JARVIS_FACE_ANTISPOOF_MIN=0

# ---------------- Mapa real (OpenStreetMap) ----------------
# Raio em metros em torno do centro da cidade (500 a 4000). Baixado 1 vez e guardado em data/mapa/.
JARVIS_MAP_RADIUS_M=1800
JARVIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Simuladores dos dispositivos futuros (LEDs, persiana, fechadura, robô). Nenhum hardware é acionado.
JARVIS_DEVICE_SIMULATORS=true

# ---------------- Servidor local ----------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Acesso pela rede: desligado. Para permitir: JARVIS_HOST=0.0.0.0, JARVIS_ALLOW_LAN=true,
# JARVIS_LOCAL_TOKEN com 24+ caracteres e JARVIS_ALLOWED_ORIGINS com o endereço exato do HUD.
JARVIS_ALLOW_LAN=false
# Opcional: token fixo do canal HUD⇄backend (por padrão é gerado a cada inicialização).
JARVIS_LOCAL_TOKEN=

# ---------------------------------------------------------------- 0.7: Telegram (opcional)
# Crie um bot com o @BotFather no Telegram e cole aqui o token dele. Depois: Configurações → Sistema → Telegram →
# "Gerar código" e mande /parear CÓDIGO para o seu bot. Só o seu chat conversa com o JARVIS.
TELEGRAM_BOT_TOKEN=
# Celular na rede de casa (Configurações → Sistema → Celular). Porta do servidor do celular:
JARVIS_MOBILE_PORT=8766
# Cotações (dólar/Bitcoin, AwesomeAPI) no resumo e por voz: on | off
JARVIS_COTACOES=on
